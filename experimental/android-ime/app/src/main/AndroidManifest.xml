<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:label="Xiaomi Türkçe Klavye Köprüsü" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
    <service android:name=".BridgeIme" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true" android:label="Xiaomi Türkçe Köprü">
      <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
    <service android:name=".GboardAccessBridge"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
        android:exported="true"
        android:label="Xiaomi Gboard Turkce Q Kopru">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService"/>
      </intent-filter>
      <meta-data android:name="android.accessibilityservice"
                 android:resource="@xml/gboard_accessibility"/>
    </service>
    <receiver android:name=".TextReceiver" android:exported="true">
      <intent-filter><action android:name="com.example.xiaomikeyboardbridge.SEND"/></intent-filter>
    </receiver>
  </application>
</manifest>
